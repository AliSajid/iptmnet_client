---
line_ending: "lf"
doublestar: true
include:
    - .github/**/*.yaml
    - .pre-commit-config.yaml
    - .releaserc.yaml
    - .yamlfmt
formatter:
    type: basic
    include_document_start: true
    line_ending: "lf"
    max_line_length: 150
    indent: 4
